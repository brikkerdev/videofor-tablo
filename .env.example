# PostgreSQL
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://app:change-me@db:5432/tablo

# HTTP API
APP_PORT=8000
API_KEY=change-me

# Часовой пояс смены дня. Пусто: системный пояс контейнера (TZ)
APP_TIMEZONE=

# Табло: базовый адрес ESP32-шлюза (docs/tablo-api.md)
TABLO_URL=http://192.168.0.64
TABLO_TOKEN=

# Подключение шлюза к матрице при старте (опционально). Пусто: шлюз уже подключён
TABLO_MATRIX_IP=192.168.0.47
TABLO_MATRIX_PASS=guest

PUSH_RETRY_SECONDS=10
LOG_LEVEL=INFO
