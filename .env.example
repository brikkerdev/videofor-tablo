# PostgreSQL
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://app:change-me@db:5432/tablo

# HTTP API
APP_PORT=8000
# Если задан — обязателен для приёма событий и всех управляющих /api/* (кроме
# /health, /, /ui/). UI хранит ключ в браузере (поле «API-ключ» на вкладке
# «Подключение»). Пусто: всё открыто (доверенная сеть).
API_KEY=change-me

# Разрешённые origin для кросс-доменных запросов, через запятую.
# Пусто: только same-origin (как сам UI). Пример: CORS_ORIGINS=https://panel.example.com
CORS_ORIGINS=

# Часовой пояс смены дня. Пусто: системный пояс контейнера (TZ)
# Пример: APP_TIMEZONE=Europe/Moscow
APP_TIMEZONE=Europe/Moscow

# Адрес ESP32-шлюза — куда сервис шлёт HTTP (REST + SSE). См. docs/tablo-api.md
TABLO_URL=http://192.168.0.64
TABLO_TOKEN=

# IP LED-матрицы. Нужен только чтобы поднять связь шлюза с матрицей, если её ещё
# нет. Уже подключённый шлюз сервис определяет сам (GET /connect.json) — тогда
# можно оставить пустым.
TABLO_MATRIX_IP=192.168.0.47
TABLO_MATRIX_PASS=guest

PUSH_RETRY_SECONDS=10
LOG_LEVEL=INFO
